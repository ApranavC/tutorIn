rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles:
    // - Read: Authenticated users (needed for dashboard/class lists)
    // - Write: Users can only edit their own profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Classes & Courses:
    // - Read/Write: Allowed for any authenticated user.
    // Note: This is an MVP production rule. For strict enterprise security, 
    // you would refine this to "Teachers can create, Students can only update attendance".
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
